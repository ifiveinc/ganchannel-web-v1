{
  "name": "ganchannel-web-v1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "generate:snapshot": "tsx --env-file=.env scripts/generate-snapshot.ts",
    "sync:circles": "tsx --env-file=.env scripts/sync-circles.ts",
    "sync:registry": "tsx scripts/sync-registry.ts",
    "generate:circle-embeddings": "tsx --env-file=.env scripts/generate-circle-embeddings.ts",
    "seed:chunks": "tsx --env-file=.env scripts/seed-chunks.ts"
  },
  "dependencies": {
    "@react-router/fs-routes": "^7.7.1",
    "@react-router/node": "^7.7.1",
    "@react-router/serve": "^7.7.1",
    "@supabase/supabase-js": "^2.112.0",
    "isbot": "^5.1.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router": "^7.7.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.7.1",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "papaparse": "^5.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
